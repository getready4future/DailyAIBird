# ── Required ──────────────────────────────────────────────────────────────────
ADMIN_SECRET=your-secret-admin-token-here

# ── AI Provider — OpenRouter (ücretsiz) ───────────────────────────────────────
AI_API_KEY=sk-or-v1-...          # openrouter.ai/keys
AI_MODEL=google/gemma-3-27b-it:free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_SITE_URL=https://dailyaibird.com
AI_SITE_NAME=Daily AI Bird

# Alternatif — Groq (ücretsiz, daha hızlı):
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=https://api.groq.com/openai/v1

# Alternatif — Google Gemini Flash (ücretsiz, en geniş limit):
# AI_API_KEY=AIza...
# AI_MODEL=gemini-1.5-flash
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default)
DATABASE_URL=sqlite:///./data/dailyaibird.db
# PostgreSQL (optional migration path)
# DATABASE_URL=postgresql://user:pass@localhost:5432/dailyaibird

# ── Scraping ──────────────────────────────────────────────────────────────────
MAX_ARTICLES_PER_SOURCE=20
SCRAPE_SCHEDULE_HOUR=6
DIGEST_SCHEDULE_HOUR=7
PLAYWRIGHT_HEADLESS=true

# ── AI Processing ─────────────────────────────────────────────────────────────
AI_BATCH_SIZE=5

# ── Optional: X/Twitter (leave blank to skip) ─────────────────────────────────
TWITTER_BEARER_TOKEN=

# ── Reddit ────────────────────────────────────────────────────────────────────
REDDIT_USER_AGENT=DailyAIBird/1.0

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
VITE_API_URL=
VITE_ADMIN_TOKEN=your-secret-admin-token-here
