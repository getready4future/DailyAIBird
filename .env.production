# Production Environment - Daily AI Bird
# Copy to .env and update values before deploying

# ===== AI Model (Gemma 4 31B via OpenRouter) =====
AI_API_KEY=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
AI_MODEL=google/gemma-4-31b-it:free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_SITE_URL=https://dailyaibird.com
AI_SITE_NAME=Daily AI Bird

# ===== Security =====
ADMIN_SECRET=your-secure-admin-password-here

# ===== Logging =====
LOG_LEVEL=INFO

# ===== Scraping Schedule =====
# Schedule times (UTC):
# SCRAPE_SCHEDULE_HOUR=6       # 6 AM UTC - Daily scrape
# DIGEST_SCHEDULE_HOUR=7       # 7 AM UTC - Daily digest generation

# ===== Data =====
# SQLite database location (in Docker volume)
# DATABASE_URL=sqlite:///./data/dailyaibird.db
