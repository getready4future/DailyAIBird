# Production Environment - Daily AI Bird
# Bu dosyayı .env olarak kopyala ve değerleri doldur
# ASLA gerçek key'leri bu dosyaya yazma — .gitignore'a ekli olmalı

# ===== AI Model (Gemma 4 31B via OpenRouter) =====
AI_API_KEY=sk-or-v1-BURAYA_YENI_KEY_GIR
AI_MODEL=google/gemma-4-31b-it:free
AI_BASE_URL=https://openrouter.ai/api/v1
AI_SITE_URL=https://dailyaibird.com
AI_SITE_NAME=Daily AI Bird

# ===== Security =====
ADMIN_SECRET=BURAYA_GUCLU_SIFRE_GIR

# ===== Logging =====
LOG_LEVEL=INFO
